# LiteForeFlow, Docker edition. Copy this file to ".env" (same folder as docker-compose.yml) and edit it.
# docker compose reads ".env" automatically.

# REQUIRED. Encrypts the credentials you save. Create one with:  openssl rand -hex 32
# BACK IT UP - without it, saved credentials cannot be read again.
LITEFOREFLOW_SECRET=

# REQUIRED. Password for the bundled Postgres. Use a long random value (openssl rand -hex 24). It is only read when the database is first created;
# Already running an older install? Keep its old password here (it was "liteforeflow" unless you set one), or first run the ALTER USER below, then put the new value here.
# To change it later run: docker compose exec postgres psql -U liteforeflow -c "ALTER USER liteforeflow PASSWORD 'new-value'" and update this file.
POSTGRES_PASSWORD=

# The address people (and webhook senders) use to reach this server.
# PUBLIC_URL=http://localhost:3000
# PORT=3000

# After you created your own account, close registration so nobody else can sign up.
# ALLOW_SIGNUP=false

# On by default in Docker: the HTTP node cannot call private/internal addresses (protects your network).
# BLOCK_PRIVATE_NETWORK=true

# Where Ollama (free local AI) runs. The default reaches Ollama on the machine that runs Docker.
# OLLAMA_HOST=http://host.docker.internal:11434

# How many workflows each worker container runs at once.
# MAX_CONCURRENCY=10

# Keep less history (saves disk space): successful runs keep only a one-line record.
# SAVE_SUCCESS_DATA=false

# Sign-in / sign-up attempts per minute from one address. Raise it if many people share one office or proxy address.
# AUTH_RATE_LIMIT_PER_MIN=20

# Largest answer a block may download from a web service (MB). Bigger answers fail the block instead of filling memory.
# HTTP_MAX_RESPONSE_MB=25

# Failure alerts (set up per workflow in the editor): at most one message per workflow in this many minutes. 0 turns the limit off.
# ALERT_COOLDOWN_MIN=10
